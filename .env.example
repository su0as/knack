# Copy to .env (gitignored) and fill in. Never commit .env.

# Nebius Token Factory key (tokenfactory.nebius.com -> API keys)
NEBIUS_API_KEY=

# Optional: override the OpenAI-compatible base URL (default is the global endpoint;
# Knack falls back to each model's regional URL automatically on 404)
# KNACK_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Optional: Nebius AI Cloud Serverless Jobs backend (PAID, not covered by Token Factory credits)
# KNACK_NEBIUS_BUCKET=
# KNACK_NEBIUS_PLATFORM=cpu-d3
# KNACK_NEBIUS_PRESET=16vcpu-64gb
# KNACK_NEBIUS_SUBNET=
# KNACK_S3_REGION=eu-north1
# AWS_PROFILE=default

# Windows/Linux headless rendering: leave unset on a desktop; on Linux servers use egl or osmesa
# MUJOCO_GL=egl
